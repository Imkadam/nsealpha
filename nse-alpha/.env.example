# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill it in. NEVER commit `.env` — it is already
# in .gitignore.
#
#   cp .env.example .env
#   python run_daily.py --simulate --email-preview   # check the layout first
#   python run_daily.py --simulate --email           # then actually send one
# ---------------------------------------------------------------------------

# --- Gmail -----------------------------------------------------------------
# Your normal Google password will NOT work. You need an App Password:
#   Google Account -> Security -> 2-Step Verification (must be ON)
#     -> App passwords -> select "Mail" -> generate
# It looks like "abcd efgh ijkl mnop". Spaces are fine.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=vishalkadam8311@gmail.com
SMTP_PASSWORD=your-16-character-app-password

# --- Other providers, if you'd rather not use Gmail ------------------------
# Outlook / Hotmail:  SMTP_HOST=smtp-mail.outlook.com   SMTP_PORT=587
# Zoho (India):       SMTP_HOST=smtp.zoho.in            SMTP_PORT=587
# Implicit TLS:       set SMTP_PORT=465 (the code switches to SMTP_SSL)
# No STARTTLS at all: SMTP_TLS=false

# --- Addresses -------------------------------------------------------------
EMAIL_FROM=vishalkadam8311@gmail.com
# Comma-separated for multiple recipients.
EMAIL_TO=vishalkadam8311@gmail.com

# --- Optional --------------------------------------------------------------
# If you publish site/ somewhere (GitHub Pages, Netlify, a home server), put the
# URL here and the email gets an "Open the full dashboard" button.
# SITE_URL=https://yourname.github.io/nse-alpha/
